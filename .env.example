# PRISM configuration.
# Copy to .env and edit. Every value here has a working default, so the
# prototype runs with no .env at all. Never commit real secrets.

# --- application ---
PRISM_LOG_LEVEL=INFO
# Load the bundled demo dataset on startup.
PRISM_DEMO_MODE=true
# Start the attack replay automatically instead of showing the finished picture.
PRISM_SIMULATION_AUTOSTART=false
PRISM_SIMULATION_TICK_SECONDS=1.2
PRISM_SIMULATION_EVENTS_PER_TICK=1

# --- correlation engine ---
# Maximum separation (seconds) for two events to be considered related at all.
PRISM_CORRELATION_WINDOW_SECONDS=1800
# Score at or above which two events join the same attack chain.
PRISM_CORRELATION_MIN_SCORE=0.70
PRISM_CORRELATION_MIN_CHAIN_EVENTS=2
PRISM_CORRELATION_WEIGHT_SAME_USER=0.35
PRISM_CORRELATION_WEIGHT_SAME_HOST=0.25
PRISM_CORRELATION_WEIGHT_HOST_PIVOT=0.40
PRISM_CORRELATION_WEIGHT_SHARED_IP=0.20
PRISM_CORRELATION_WEIGHT_SUSPICIOUS_COINCIDENCE=0.25
PRISM_CORRELATION_WEIGHT_TIME_PROXIMITY=0.25

# --- lateral movement rule ---
PRISM_LATERAL_WINDOW_SECONDS=600
PRISM_LATERAL_MIN_CORRELATION_SCORE=0.70

# --- next-target prediction ---
PRISM_PREDICTION_WEIGHT_USER_ACCESS=30
PRISM_PREDICTION_WEIGHT_PRIVILEGE=25
PRISM_PREDICTION_WEIGHT_CONNECTIVITY=20
PRISM_PREDICTION_WEIGHT_CRITICALITY=20
PRISM_PREDICTION_WEIGHT_RECENT_ACTIVITY=15
PRISM_PREDICTION_WEIGHT_PATH_PROXIMITY=20
PRISM_PREDICTION_NORMALISATION_CEILING=140
PRISM_PREDICTION_MAX_PREDICTIONS=4

# --- optional Neo4j mirror (NetworkX is always used for analysis) ---
PRISM_NEO4J_ENABLED=false
PRISM_NEO4J_URI=bolt://localhost:7687
PRISM_NEO4J_USER=neo4j
PRISM_NEO4J_PASSWORD=
PRISM_NEO4J_DATABASE=neo4j

# --- agentic investigation layer ---
PRISM_AGENTS_ENABLED=true
# Pause between agent steps so an investigation is watchable in a demo.
# Set to 0 for full speed.
PRISM_AGENTS_STEP_DELAY_SECONDS=0.55
PRISM_AGENTS_MIN_FINDING_CONFIDENCE=0.45
# How far verification drops a finding whose evidence it cannot re-derive.
PRISM_AGENTS_VERIFICATION_DOWNGRADE=0.35
PRISM_AGENTS_MAX_INVESTIGATIONS=20

# --- optional LLM narrator ---
# The agents are tool-driven and need no model: every fact is retrieved through
# the tool layer and checked by the Verification Agent. A model, if configured,
# only rephrases findings that are already verified, and its output is rejected
# if it introduces a host or technique that was not in the verified set.
#
# Leave provider=none to use the deterministic narrator.
PRISM_LLM_PROVIDER=none
PRISM_LLM_MODEL=claude-sonnet-5
# Read from here, or from ANTHROPIC_API_KEY / OPENAI_API_KEY. Never commit a key.
PRISM_LLM_API_KEY=
PRISM_LLM_MAX_TOKENS=900
PRISM_LLM_TIMEOUT_SECONDS=30
