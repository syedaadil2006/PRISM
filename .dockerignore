# Keep the build context small and free of local state and secrets.
.git/
.venv/
.tools/
**/node_modules/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
*.log
.env
frontend/dist/
backend/data/*.db*
backend/data/.prism_token
backend/data/tls/
backend/data/backups/
backend/data/live/
backend/data/botsv1/raw/
backend/tests/
screenshots/
*.mp4
*.wav
*.pptx
*.docx
*.png
*.jpg
